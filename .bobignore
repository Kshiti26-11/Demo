# Keep IBM Bob out of bulky or generated files (saves Bobcoins).
# NOTE: .syncsnitch/ is deliberately NOT ignored - Bob must read its run artifacts.
.venv/
**/__pycache__/
.pytest_cache/
uv.lock
web/_vendor/
**/gen/
**/*.binpb
bob_sessions/screenshots/
bob_sessions/raw/

# Secrets: never let Bob (or an API-model agent) read them
.env
.env.*
*credential*
*secret*
*password*
*apikey*
*api-key*
*api_key*
*API_KEY*
*ACCESS_TOKEN*
*access_token*
*AUTH_TOKEN*
*auth_token*
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_dsa
