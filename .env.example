# ============================================
# SYNCSNITCH - ENVIRONMENT VARIABLES
# ============================================
#
# INSTRUCTIONS:
# 1. Don't hand-edit this file's values here. Use the setup scripts instead:
#      bash scripts/gemini_setup.sh   bash scripts/groq_setup.sh
#      bash scripts/grok_setup.sh     bash scripts/claude_setup.sh
#      bash scripts/bob_setup.sh      bash scripts/cloud_setup.sh
#    Each one prompts for the key (hidden input) and writes it to .env.local,
#    which is gitignored and chmod 600. This file (.env.example) documents the
#    variables; it is safe to commit and never holds a real value.
# 2. NEVER commit a .env or .env.local file, and never paste a real key into a
#    chat with an AI assistant (Bob, Claude, Copilot, ...): describe the
#    problem and let the setup script collect the key instead.
#
# ============================================

# --- Pick ONE agent engine ---------------------------------------------------
# auto = the first of IBM Bob, Gemini, Groq, Grok, Claude that is set up
SYNCSNITCH_AGENT_BACKEND=auto

# --- IBM Bob (headless IBM Bob Shell) ----------------------------------------
BOB_API_KEY=your_bob_api_key_here_DO_NOT_COMMIT
BOB_TEAM_ID=
SYNCSNITCH_BOB_BUDGET=5

# --- Gemini (Google AI Studio, free tier) ------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here_DO_NOT_COMMIT
SYNCSNITCH_GEMINI_MODEL=gemini-3.5-flash
SYNCSNITCH_GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# --- Groq (GroqCloud, free tier) ---------------------------------------------
GROQ_API_KEY=your_groq_api_key_here_DO_NOT_COMMIT
SYNCSNITCH_GROQ_MODEL=llama-3.1-8b-instant
SYNCSNITCH_GROQ_FALLBACK_MODELS=

# --- Grok (xAI) ---------------------------------------------------------------
XAI_API_KEY=your_xai_api_key_here_DO_NOT_COMMIT
SYNCSNITCH_GROK_MODEL=grok-4.7

# --- Claude (Anthropic) --------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here_DO_NOT_COMMIT
SYNCSNITCH_CLAUDE_MODEL=claude-opus-5-5
SYNCSNITCH_CLAUDE_TOKEN_BUDGET=3000000

# --- Shared per-run budget for any API engine (tokens, all 3 agents) ---------
SYNCSNITCH_TOKEN_BUDGET=3000000

# --- Cloud runner (scripts/cloud_setup.sh sets these on GitHub, not here) ----
# SYNCSNITCH_RUNNER_REPO=<owner>/syncsnitch-runner
# SYNCSNITCH_PUSH_TOKEN is a GitHub Actions secret, never a local .env value

# ============================================
# SECURITY REMINDERS
# - This .env.example file is safe to commit; it holds no real value.
# - Real keys live in .env.local (gitignored, chmod 600) or in the runner
#   repo's GitHub Actions secrets - never in code, never in a commit.
# - Never share a real key with an AI assistant, in code comments, or in a
#   run's logs. The website's engines are sandboxed so keys never reach the
#   agents' own tool calls (git, pytest, etc).
# ============================================
